# Application
APP_NAME=WTH: What The Human
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# Provider mode
# Allowed values: mock, live
PROVIDER_MODE=live

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Groq
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=3

# Google Gemini Embeddings
GOOGLE_API_KEY=replace-with-google-api-key
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.55
CONCEPT_ACTIVATION_THRESHOLD=0.50
CONCEPT_AMBIGUITY_MARGIN=0.05
MAX_ACTIVATED_CONCEPTS=3

# Query validation
QUESTION_MIN_LENGTH=3
QUESTION_MAX_LENGTH=1000

# Logging and privacy
LOG_FULL_QUESTION_TEXT=false
QUERY_RETENTION_DAYS=30

# Health and readiness
READINESS_CHECK_DATABASE=false
READINESS_CHECK_PROVIDERS=false