# Stage 6 deployment environment names only.
# NEVER place real secrets in this file.

APP_ENV=production
PROVIDER_MODE=live

SUPABASE_URL=
SUPABASE_SECRET_KEY=

GROQ_API_KEY=
GOOGLE_API_KEY=

# Use the existing CORS_ORIGINS format expected by apps/api/core/config.py.
# Production origins must be HTTPS and must not contain "*".
CORS_ORIGINS=https://your-frontend.example

LOG_LEVEL=INFO

# Stage 6.1B edge controls.
WTH_MAX_QUERY_BODY_BYTES=16384

# Initial single-instance limits. Tune after observing real usage.
WTH_QUERY_RATE_LIMIT_REQUESTS=5
WTH_QUERY_RATE_LIMIT_WINDOW_SECONDS=600

WTH_CHUNK_RATE_LIMIT_REQUESTS=60
WTH_CHUNK_RATE_LIMIT_WINDOW_SECONDS=60
